# ============================================================================
# Barbearia Bolshoi — variáveis de ambiente
#
# SEM ESTE ARQUIVO O SISTEMA SOBE EM MODO DEV: SQLite local (./dev.db), IA em
# modo demonstração, WhatsApp fake capturado no simulador (/dev/simulador),
# JWT efêmero e dados demo (login admin/admin123 no dashboard). Preencha as
# variáveis abaixo para ligar cada subsistema real — e defina APP_ENV=production
# em produção para que qualquer credencial faltante ABORTE o boot em vez de
# cair silenciosamente em modo dev.
# ============================================================================

# Ambiente: vazio = autodetecção (dev quando faltam credenciais),
# development = força modo dev, production = exige todas as credenciais.
APP_ENV=

# --- Banco de Dados (MySQL) -------------------------------------------------
# Definir QUALQUER DB_* ativa o MySQL. Sem nenhum, o modo dev usa sqlite:///dev.db.
DB_USER=root
DB_PASS=sua_senha_aqui
DB_HOST=localhost
DB_NAME=nome_do_banco_aqui
# Alternativa: URL SQLAlchemy completa (tem precedência sobre DB_*).
# DB_URL=mysql+pymysql://user:pass@host/db?charset=utf8mb4

# --- Meta WhatsApp Cloud API -------------------------------------------------
WHATSAPP_TOKEN=seu_token_aqui
WHATSAPP_PHONE_ID=seu_phone_id_aqui
WEBHOOK_VERIFY_TOKEN=seu_token_verificacao_aqui

# Segurança do webhook (HMAC-SHA256)
# Obrigatório em produção — o servidor não sobe sem este valor.
# Encontre em: Meta for Developers → seu App → WhatsApp → Configuração → App Secret.
META_APP_SECRET=
# 1 = aceita webhook sem HMAC fora do modo dev; em prod NÃO defina e configure META_APP_SECRET
ALLOW_UNSIGNED_WEBHOOK=

# --- NVIDIA NIM API (Llama 3.1 70B) ------------------------------------------
# Gere em https://build.nvidia.com — sem esta chave a IA responde em modo demo.
NVIDIA_API_KEY=sua_chave_nvidia_aqui

# --- Modo de operação ---------------------------------------------------------
#   bot_only → IA responde sozinha. Sem dashboard, sem fila de espera.
#   hibrido  → IA + atendente humano via dashboard. Transbordo coloca cliente em fila.
# ATENÇÃO: em modo dev (sem credenciais) o default é "hibrido"; com .env real o
# default volta a "bot_only" — defina explicitamente o modo desejado aqui.
MODO_OPERACAO=bot_only

# --- Dashboard admin (modo híbrido) -------------------------------------------
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
# TTL do token em minutos. O dashboard renova sozinho perto do expiry
# (POST /admin/refresh), com teto absoluto de 12h por sessão.
JWT_TTL_MIN=15

# --- Comportamento do bot ------------------------------------------------------
# Telefones (separados por vírgula) autorizados aos comandos !reiniciar / !status
ADMIN_PHONES=
# Horas até o bot reativar sozinho após handoff sem atendimento (default 24)
BOT_REATIVAR_APOS_HORAS=24
# Mensagens por minuto por telefone antes de silenciar (default 10; dev usa 60)
RATE_LIMIT_MSGS_POR_MINUTO=10

# --- Circuit breaker da IA -----------------------------------------------------
# Falhas consecutivas antes de abrir o circuito (default 3) e segundos até
# tentar fechar de novo (default 30)
CB_FAILURE_THRESHOLD=3
CB_RESET_TIMEOUT=30

# --- Observabilidade -----------------------------------------------------------
# DEBUG mostra payload completo da IA nos logs
LOG_LEVEL=INFO
# DSN do Sentry (opcional; requer pip install sentry-sdk)
SENTRY_DSN=
